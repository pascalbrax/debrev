#!/usr/bin/python3 -I
"""keepalived notify (runs as root): record the VRRP state and let the node that
holds the virtual IP be the one that talks to Let's Encrypt."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from debrev import cluster, node  # noqa: E402
from debrev.paths import Paths  # noqa: E402

# keepalived calls: <TYPE> <NAME> <STATE> <PRIORITY>
if len(sys.argv) < 4:
    sys.exit(0)
if sys.argv[3].upper() not in ("MASTER", "BACKUP", "FAULT", "STOP"):
    sys.exit(0)
try:
    state = cluster.record_vrrp_state(Paths(), sys.argv[3])
except (node.NodeError, OSError) as e:
    print(f"debrev-vrrp-notify: {e}", file=sys.stderr)
    sys.exit(1)
print(f"debrev: VRRP state is now {state}")
