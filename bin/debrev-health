#!/usr/bin/python3 -I
"""keepalived health check: exit 0 only if nginx answers locally."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from debrev import cluster  # noqa: E402
from debrev.paths import Paths  # noqa: E402

ok, msg = cluster.health(Paths())
if not ok:
    print(msg, file=sys.stderr)
sys.exit(0 if ok else 1)
